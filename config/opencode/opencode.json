{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "git commit *": "deny",
      "git push *": "deny",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask"
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    },
    "headroom": {
      "type": "local",
      "command": [
        "headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  },
  "disabled_providers": [
    "headroom",
    "nano-gpt",
    "openrouter"
  ],
  "provider": {
    "opencode-go": {
      "whitelist": [
        "gpt-6-luna",
        "glm-5.3-flash",
        "kimi-k3",
        "kimi-k2.7-code"
      ]
    }
  }
}
